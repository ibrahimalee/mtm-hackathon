LLM_BASE_URL=https://api.groq.com/openai/v1
# One key per teammate, comma-separated. Rotated on 429/5xx/timeout (same model).
LLM_API_KEYS=key_one,key_two
LLM_MODEL=your-model-id
# Comma-separated allowlist; the client refuses any model not listed here.
LLM_ALLOWED_MODELS=your-model-id
# Optional fallback provider (same model only)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_KEY=
